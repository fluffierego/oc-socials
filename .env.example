FLASK_SECRET=put-a-long-random-string-here
PORT=5050

# Discord Developer Portal -> OAuth2
DISCORD_CLIENT_ID=YOUR_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_CLIENT_SECRET
DISCORD_REDIRECT_URI=http://127.0.0.1:5050/oauth/callback

# Optional, only if you later connect a Tupperbox/Discord bridge bot.
TUPPER_BRIDGE_SECRET=change-this
